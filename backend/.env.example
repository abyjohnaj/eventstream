# ============================================================
# EventStream API — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# PostgreSQL (automatically set by Railway if you add a Postgres plugin)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# LiveKit Cloud credentials (https://cloud.livekit.io)
LIVEKIT_API_KEY="your_livekit_api_key"
LIVEKIT_API_SECRET="your_livekit_api_secret"
LIVEKIT_URL="wss://your-project.livekit.cloud"

# Server Port (Railway sets this automatically — do not hardcode)
PORT=4000
